# AEI Mobile — environment variables
# Copy this file to .env and fill in values.
# Leave EXPO_PUBLIC_BACKEND_URL empty to use Demo Mode only.

# URL of the Python FastAPI backend (e.g. http://192.168.1.100:8000)
# When empty, all API calls return deterministic synthetic mock data.
EXPO_PUBLIC_BACKEND_URL=

# Optional training operations sync, never use localhost for a physical phone.
# EXPO_PUBLIC_DEMO_SERVER_URL=https://your-training-server.example

# Optional shared training operations. Core location/routing works without this server.
# Restart Metro after changing EXPO_PUBLIC settings.
EXPO_PUBLIC_DEMO_SERVER_URL=
# Optional institution/self-hosted Overpass endpoint. Blank uses the documented public services.
EXPO_PUBLIC_OVERPASS_URL=
